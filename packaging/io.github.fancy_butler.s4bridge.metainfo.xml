  <name>S4 Bridge</name>
  <summary>Use the original Traktor Kontrol S4 with Mixxx and any MIDI software</summary>
  <developer id="io.github.fancy_butler">
    <name>Fancy Butler</name>
  </developer>
  <description>
    <p>
      The original (MK1) Native Instruments Traktor Kontrol S4 only ever worked with Traktor.
      S4 Bridge turns it into a full MIDI controller with LED feedback, so it works with Mixxx,
      DAWs and anything else that speaks MIDI.
    </p>
    <ul>
      <li>Four decks with per-deck LED memory and soft takeover</li>
      <li>One-click Mixxx setup: mapping, controller and audio routing</li>
      <li>Traktor-style cues, loops, FLUX, Mixer FX, samples, stems and loop rolls</li>
      <li>Live on-screen surface, mapping editor and health check</li>
      <li>Standalone mixer mode: the S4 as a four-channel mixer, no DJ software needed</li>
      <li>Lives quietly in the system tray</li>
    </ul>
  </description>
  <launchable type="desktop-id">s4bridge.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Audio</category>
  </categories>
  <keywords>
    <keyword>Traktor</keyword>
    <keyword>Kontrol S4</keyword>
    <keyword>DJ</keyword>
    <keyword>MIDI</keyword>
    <keyword>Mixxx</keyword>
  </keywords>
  <provides>
    <modalias>usb:v17CCpBAFF*</modalias>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
