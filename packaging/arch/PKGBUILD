# Maintainer: Fancy Butler
# Build from a local checkout:  cd packaging/arch && makepkg -si
pkgname=s4bridge
pkgver=0.7.0
pkgrel=1
pkgdesc="Use the Traktor Kontrol S4 MK1 with Mixxx and any MIDI software (snd-usb-caiaq bridge)"
arch=('any')
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'python-evdev' 'python-pyusb' 'libusb' 'alsa-lib'
         'python-numpy' 'python-scipy' 'python-jack-client' 'pipewire-jack')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('mixxx: DJ software with a bundled mapping')
source=()

_root="$(realpath "$startdir/../..")"

build() {
  cd "$_root"
  python -m build --wheel --no-isolation --outdir "$srcdir/dist"
}

package() {
  cd "$_root"
  python -m installer --destdir="$pkgdir" "$srcdir"/dist/*.whl
  install -Dm644 packaging/70-s4bridge.rules "$pkgdir/usr/lib/udev/rules.d/70-s4bridge.rules"
  install -Dm644 packaging/s4bridge.desktop "$pkgdir/usr/share/applications/s4bridge.desktop"
  install -Dm644 packaging/s4bridge.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/s4bridge.svg"
  for n in 16 22 24 32 48 64 128 256 512; do
    install -Dm644 "packaging/icons/s4bridge-$n.png" "$pkgdir/usr/share/icons/hicolor/${n}x${n}/apps/s4bridge.png"
  done
  install -Dm644 packaging/io.github.fancy_butler.s4bridge.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 packaging/s4bridge.service "$pkgdir/usr/lib/systemd/user/s4bridge.service"
  install -Dm644 mappings/mixxx/* -t "$pkgdir/usr/share/s4bridge/mixxx/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
